CONTAINER_NAME=detection_agent_virtual_alice
IMAGE_NAME=ghcr.io/measurement-plane/detection-agent:latest

BROKER_URL=nats://host.docker.internal:4222
ENDPOINT=/timetagger/alice

TT_TYPE=virtual
TT_SERIAL=virtual-alice
PPS_CHANNEL=8
TT_CHANNELS=1|2|3|4|8
MAX_EVENTS=10000000
BUFFER_SECONDS=10

VIRTUAL_SECONDS=20
VIRTUAL_EVENTS_PER_SECOND=500000
VIRTUAL_SEED=12345
VIRTUAL_DATASET_FILE=

TT_TRIGGER_LEVELS=
TT_EVENT_DIVIDERS=
TT_DEAD_TIMES=
TT_DELAYS=

DOCKER_EXTRA_ARGS=--add-host=host.docker.internal:host-gateway
