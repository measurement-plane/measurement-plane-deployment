BROKER_URL=nats://nats:4222
ORCHESTRATOR_URL=http://experiment-orchestrator:8080
ORCHESTRATOR_HOST_PORT=18080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
AUTH_SECRET=replace-with-a-long-random-secret
TWTT_ENDPOINT=/twtt
APC_ENDPOINT=/apc/main
APC_DRIVER_TYPE=qunnect
APC_REQUEST_TIMEOUT_S=10
APC_VERIFY_SSL=true
# Entanglement distribution defaults. Calibrate peak0 for the installed link.
ENTANGLEMENT_DISTRIBUTION_ENDPOINT=/entanglement-distribution
ENTANGLEMENT_PEAK0_PS=0
ENTANGLEMENT_RANGE_NS=10
ENTANGLEMENT_TIME_BIN_NS=0.1
ENTANGLEMENT_WINDOW_NS=1
ENTANGLEMENT_INTEGRATION_MS=100
