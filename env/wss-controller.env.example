CONTAINER_NAME=wss_controller
IMAGE_NAME=ghcr.io/measurement-plane/wss-controller:latest

BROKER_URL=nats://host.docker.internal:4222
ENDPOINT=/wss/module-1

# 'serial' (real hardware) or 'dummy' (simulated, no device needed)
DRIVER_TYPE=serial
# The module's serial device. Prefer the stable /dev/serial/by-id/... name, or
# 'auto' to have the agent find the module by probing the USB serial ports.
WSS_SERIAL_PORT=/dev/ttyUSB0
WSS_SERIAL_BAUDRATE=115200
WSS_COMMAND_TIMEOUT=2.0

# The module's own serial number (wss_module_info). Selects the module in auto
# mode, which is required when several are connected; with a fixed port the
# agent refuses to start if the module there has another serial number.
WSS_MODULE_SERIAL=
# Auto mode only. Probe just the ports matching one of these (USB id such as
# 0403:6001, or text in the device path, by-id name, adapter serial or
# description), and never these ports (comma-separated paths).
WSS_SERIAL_MATCH=
WSS_SERIAL_EXCLUDE=

# Optional extra docker args, for example:
# DOCKER_EXTRA_ARGS=--add-host=host.docker.internal:host-gateway
DOCKER_EXTRA_ARGS=
