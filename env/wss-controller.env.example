CONTAINER_NAME=wss_controller
IMAGE_NAME=ghcr.io/measurement-plane/wss-controller:latest

BROKER_URL=nats://host.docker.internal:4222
ENDPOINT=/wss/module-1

# 'serial' (real hardware) or 'dummy' (simulated, no device needed)
DRIVER_TYPE=serial
WSS_SERIAL_PORT=/dev/ttyUSB0
WSS_SERIAL_BAUDRATE=115200
WSS_COMMAND_TIMEOUT=2.0

# Optional extra docker args, for example:
# DOCKER_EXTRA_ARGS=--add-host=host.docker.internal:host-gateway
DOCKER_EXTRA_ARGS=
