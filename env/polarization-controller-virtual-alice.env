CONTAINER_NAME=polarization_controller_virtual_alice
IMAGE_NAME=ghcr.io/measurement-plane/polarization-controller:latest

BROKER_URL=nats://host.docker.internal:4222
ENDPOINT=/polarizer/alice

HWP_ADDR=VIRTUAL_HWP_ALICE
QWP_ADDR=VIRTUAL_QWP_ALICE
DRIVER_TYPE=virtual

DOCKER_EXTRA_ARGS=--add-host=host.docker.internal:host-gateway
