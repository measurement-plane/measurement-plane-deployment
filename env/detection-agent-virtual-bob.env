CONTAINER_NAME=detection_agent_virtual_bob
IMAGE_NAME=ghcr.io/measurement-plane/detection-agent:latest

BROKER_URL=nats://host.docker.internal:4222
ENDPOINT=/timetagger/bob

TT_TYPE=virtual
TT_SERIAL=virtual-bob
PPS_CHANNEL=8
TT_CHANNELS=1|2|3|4|8
MAX_EVENTS=10000000
BUFFER_SECONDS=10

VIRTUAL_SECONDS=20
VIRTUAL_EVENTS_PER_SECOND=500000
VIRTUAL_SEED=67890
VIRTUAL_DATASET_FILE=

TT_TRIGGER_LEVELS=
TT_EVENT_DIVIDERS=
TT_DEAD_TIMES=
TT_DELAYS=

DOCKER_EXTRA_ARGS=
