CONTAINER_NAME=detection_agent_container
IMAGE_NAME=ghcr.io/measurement-plane/detection-agent:latest

BROKER_URL=nats://host.docker.internal:4222
ENDPOINT=/timetagger/alice

TT_TYPE=swabian
TT_SERIAL=2138000XI2
PPS_CHANNEL=8
TT_CHANNELS=1|2|3|4|5|6|7|8
MAX_EVENTS=10000000
BUFFER_SECONDS=10

# Virtual driver settings. Use these when TT_TYPE=virtual.
VIRTUAL_SECONDS=20
VIRTUAL_EVENTS_PER_SECOND=500000
VIRTUAL_SEED=12345
VIRTUAL_DATASET_FILE=

TT_TRIGGER_LEVELS=1=0.5,2=0.5,3=0.5,4=0.5,5=0.5,6=0.5,7=0.5,8=0.5
TT_EVENT_DIVIDERS=1=10,2=10,3=10,4=10
TT_DEAD_TIMES=
TT_DELAYS=

# Optional extra docker args, for example:
# DOCKER_EXTRA_ARGS=--add-host=host.docker.internal:host-gateway
DOCKER_EXTRA_ARGS=

# Windows Docker Desktop USB forwarding. The one-time usbipd bind must be run as Administrator.
TIMETAGGER_USB_AUTO_ATTACH=true
TIMETAGGER_USB_HARDWARE_ID=151f:0023
TIMETAGGER_USB_READY_TIMEOUT=15

# Follow logs after deployment; Ctrl+C stops log viewing but not the detached container.
FOLLOW_LOGS=true
LOG_TAIL=100
