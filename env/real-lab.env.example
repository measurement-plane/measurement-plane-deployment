# Central node core deployment env file.
CORE_ENV_FILE=.env

# Prefer SSH keys or an SSH config alias instead of storing passwords.
# Use values like:
#   ALICE_SSH_TARGET=alice-qnet
# or
#   ALICE_SSH_TARGET=user@10.0.0.21
ALICE_SSH_TARGET=alice-qnet
BOB_SSH_TARGET=bob-qnet

# Remote path where measurement-plane-deployment will be synchronized before running scripts.
REMOTE_DEPLOY_ROOT=~/measurement-plane-deployment
ALICE_REMOTE_DEPLOY_ROOT=
BOB_REMOTE_DEPLOY_ROOT=

# Existing per-node env files, relative to measurement-plane-deployment on the target host.
ALICE_DETECTOR_ENV=env/detection-agent-alice.env
ALICE_POLARIZER_ENV=env/polarization-controller-alice.env
BOB_DETECTOR_ENV=env/detection-agent-bob.env
BOB_POLARIZER_ENV=env/polarization-controller-bob.env

# Optional SSH flags, for example:
# SSH_COMMON_ARGS=-i ~/.ssh/qnet_lab -o StrictHostKeyChecking=accept-new
SSH_COMMON_ARGS=

# Optional remote command used to start Docker if the daemon is not already running.
# Override this if your lab hosts use something other than systemd/service.
REMOTE_DOCKER_START_CMD=sudo -n systemctl start docker || systemctl start docker || sudo -n service docker start || service docker start

# Set to 0 if you want remote hardware agents deployed before the central core.
DEPLOY_CORE_FIRST=1

# Set to 1 to print commands without executing them.
DRY_RUN=0
