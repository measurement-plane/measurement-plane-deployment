CONTAINER_NAME=snspd_agent
IMAGE_NAME=ghcr.io/measurement-plane/snspd-agent:latest

BROKER_URL=nats://host.docker.internal:4222
ENDPOINT=/snspd/fury
SNSPD_NAME=Fury

SNSPD_DRIVER_TYPE=opus
# Stable QOELEC path (Microchip VID 04D8, PID EF24): ls -l /dev/serial/by-id/
SNSPD_TTY=/dev/serial/by-id/usb-REPLACE_WITH_QOELEC_ID-if00
# Optional QOELEC USB serial number; empty uses the first QOELEC found.
SNSPD_SERIAL=

# Thermometer input and calibration curve per stage (files in snspd-agent drivers/calibration).
# Confirm on site that T2K reads ~1.7 K when cold.
SNSPD_T2K_THERM_CH=1
SNSPD_T2K_CAL=T160.cal
SNSPD_T40K_THERM_CH=0
SNSPD_T40K_CAL=T159.cal

# Bias safety
SNSPD_MAX_BIAS_UA=1=12,2=12
SNSPD_BIAS_RAMP_STEP_UA=0.5
SNSPD_MAX_OPERATING_T_K=3.5

# Background poll; set SNSPD_LOG_DIR to keep writing the daily Fury_log_<date>.dat files.
SNSPD_POLL_INTERVAL_S=5
SNSPD_LOG_DIR=

# Optional extra docker args, for example:
# DOCKER_EXTRA_ARGS=--add-host=host.docker.internal:host-gateway
DOCKER_EXTRA_ARGS=
